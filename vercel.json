{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/campusroute-probe",
      "destination": "/api/probe"
    },
    {
      "source": "/campusroute",
      "destination": "/api/campusroute?path="
    },
    {
      "source": "/campusroute/:path*",
      "destination": "/api/campusroute?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  }
}
