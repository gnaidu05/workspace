# Copy to .env and adjust as needed.

# Port the server listens on
PORT=3000

# Secret used to sign authentication tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Local / self-hosted storage (used when the vars below are NOT set) ---
# Location of the local SQLite database file
DB_PATH=./data.db
# Directory where uploaded files are stored on disk
UPLOAD_DIR=./uploads

# Maximum upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# --- Serverless / Vercel storage (set these to use Turso + Vercel Blob) ---
# Turso (libSQL) database. When TURSO_DATABASE_URL is set, the app uses it
# instead of the local SQLite file above. Create one at https://turso.tech
# (CLI: `turso db create nimbus` then `turso db show --url nimbus`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob read/write token. When set (or when running on Vercel), uploaded
# files are stored in Vercel Blob instead of on local disk. Get it from the
# Vercel dashboard: Storage → Blob → your store → tokens.
BLOB_READ_WRITE_TOKEN=
