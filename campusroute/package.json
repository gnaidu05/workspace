{
  "name": "campusroute",
  "version": "1.0.0",
  "description": "Public, no-login multi-stop assessment travel planner: group college visits into shared routes across road, air and rail.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "build:single": "node scripts/build-single-file.js",
    "build:pages": "node scripts/build-single-file.js && cp docs/campusroute.html ../docs/campusroute.html"
  },
  "keywords": ["travel-planning", "route-optimisation", "itinerary", "openstreetmap", "osrm"],
  "license": "MIT",
  "engines": { "node": ">=20" }
}
